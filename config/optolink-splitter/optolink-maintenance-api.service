[Unit]
Description=Optolink guarded maintenance MQTT API
After=network-online.target optolink-splitter.service
Wants=network-online.target
Requires=optolink-splitter.service
PartOf=optolink-splitter.service

[Service]
Type=simple
User=optolink
Group=optolink
WorkingDirectory=/opt/optolink
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/optolink-maintenance-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
