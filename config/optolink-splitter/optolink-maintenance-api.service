# MQTT facade for the guarded maintenance core. Controller safety rules live in
# /opt/optolink/optolink_maintenance_core.py and are shared with the CLI.

[Unit]
Description=Optolink guarded maintenance MQTT API
After=network-online.target optolink-splitter.service
Wants=network-online.target optolink-splitter.service

[Service]
Type=simple
User=optolink
Group=optolink
WorkingDirectory=/opt/optolink
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/optolink-maintenance-api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
