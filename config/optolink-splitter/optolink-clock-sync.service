[Unit]
Description=Synchronize Viessmann WB2A system clock via Optolink-Splitter
After=network-online.target optolink-splitter.service
Wants=network-online.target
Requires=optolink-splitter.service

[Service]
Type=oneshot
User=optolink
Group=optolink
ExecStart=/usr/local/bin/optolink-clock-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run

