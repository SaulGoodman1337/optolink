[Unit]
Description=Optolink VDensHO1 Party emulation
After=network-online.target optolink-splitter.service
Wants=network-online.target
Requires=optolink-splitter.service
PartOf=optolink-splitter.service

[Service]
Type=simple
User=optolink
Group=optolink
WorkingDirectory=/opt/optolink
Environment=PYTHONUNBUFFERED=1
StateDirectory=optolink-party
StateDirectoryMode=0750
ExecStart=/usr/local/bin/optolink-party-emulator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
